# Configuration for the /scala-plan and /scala-implement workflow scripts.
# Sourced by .claude/scripts/*.sh and .claude/hooks/*.sh. Paths are relative to the repository root.

# Directory containing build.sbt.
SBT_ROOT=examples

# sbt launcher. `sbt -batch` starts a fresh JVM per gate run; `sbt --client` reuses a warm
# server (faster) but shares session state with any IDE connected to the same server.
SBT_CMD="sbt -batch -no-colors"


# Modules whose main sources may run effects unsafely (the `ZIOAppDefault` entry point).
# style-lint.sh skips the effect-boundary rules for paths under these directories.
APP_DIRS="app"

# Fail the test gate when no test was executed (catches a missing test framework).
REQUIRE_TESTS=1
