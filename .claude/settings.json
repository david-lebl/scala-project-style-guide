{
  "permissions": {
    "allow": [
      "Bash(sbt *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(.claude/scripts/scala-gates.sh*)",
      "Bash(.claude/scripts/style-lint.sh*)",
      "Bash(.claude/scripts/run-state.sh*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-remote-git.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-guard.sh\""
          }
        ]
      }
    ]
  }
}
